# ==========================================
# AI Exclusion File
# Optimizes AI context by ignoring heavy, 
# auto-generated, or sensitive files.
# ==========================================

# 1. Dependencies (HEAVY - Do not index!)
**/node_modules/
package-lock.json
yarn.lock

# 2. Environment Variables & Secrets
**/.env
**/.env.*
*.pem
*.key

# 3. Logs & Caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.npm/

# 4. OS & Editor Generated Files
.DS_Store
Thumbs.db
.vscode/
.idea/

# 5. Build Outputs (if you add build tools later)
dist/
build/
out/

# 6. Android & Capacitor generated files (keep native source indexable)
**/android/build/
**/android/**/build/
**/android/.gradle/
**/android/.idea/
**/android/.cxx/
**/android/captures/
**/android/local.properties
**/android/app/src/main/assets/public/
**/android/**/*.apk
**/android/**/*.aab
**/android/**/*.aar
**/android/**/*.dex
**/android/**/*.class
**/android/**/*.hprof